#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@kicksecure.com>
## See the file COPYING for copying conditions.

## AI-Assisted

## csr-build: build the Computer Security Research previews site in the sandbox
## qube (where pandoc + texlive live) and pull the rendered _site back here, then
## commit + push it. The deployed HTML/.tex are built HERE, not in GitHub CI; the
## binary PDF is gitignored and rendered at deploy time (journal-maker --pdf-only).
##
## Run from this VM; no host pandoc needed. The source of truth stays paper.md +
## refs.bib + site.toml; running csr-build is how a change gets published.
##
## Usage: bin/csr-build [--no-commit]
##   --no-commit   build + pull _site only; do not commit or push.
##
## Env overrides:
##   CSR_SANDBOX_TARGET   sandbox qube (default: temp-claude)
##   CSR_JOURNAL_MAKER    journal-maker checkout (default: sibling of this repo)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

target="${CSR_SANDBOX_TARGET:-temp-claude}"

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"
content_dir="$(dirname -- "${script_dir}")"
journal_maker="${CSR_JOURNAL_MAKER:-$(dirname -- "${content_dir}")/journal-maker}"
dist_ai="${CSR_DIST_AI:-$(dirname -- "${content_dir}")/dist-ai}"
check_site="${dist_ai}/usr/share/website-tests/check_site.py"
check_svg_safety="${dist_ai}/usr/share/website-tests/check_svg_safety.py"

## Working-tree changes outside _site (tracked or untracked). Single source for
## both the pre-build guard and the post-build re-check so their scope cannot
## drift apart.
dirty_sources_outside_site() {
   ## Dirty RENDER INPUTS outside _site (articles/, pages/, site.toml + per-
   ## article refs.bib/source-quotes.toml), tracked or untracked. Shared by the
   ## pre-build guard and the post-build re-check so their scope cannot drift.
   ## Exclude _site (output) and the non-render tooling/meta (bin/, tests/,
   ## .github, repo dotfiles) -- a dirty build script or CI file is not a raced
   ## render and must not block a content deploy. Fail-closed: a NEW top-level
   ## content path is guarded by default (only listed tooling is skipped).
   ## --untracked-files=all overrides a user's status.showUntrackedFiles=no.
   git -C "${content_dir}" status --porcelain --untracked-files=all -- . ':(exclude)_site' ':(exclude)bin' ':(exclude)tests' ':(exclude).github' ':(exclude).gitattributes' ':(exclude).gitignore'
}

do_commit=1
if [ "${1:-}" = "--no-commit" ]; then
   do_commit=0
elif [ "$#" -gt 0 ]; then
   printf '%s\n' "csr-build: unknown argument: ${1}" >&2
   exit 1
fi

if [ ! -f "${content_dir}/site.toml" ]; then
   printf '%s\n' "csr-build: ${content_dir} is not a CSR content repo (no site.toml)" >&2
   exit 1
fi

## Refuse to build+publish when article SOURCES are uncommitted. csr-build
## deploys the _site it renders from the WORKING TREE but commits only _site
## (below), so an uncommitted render-input edit (paper.md, refs.bib,
## source-quotes.toml, meta.toml, site.toml, ...) would ship in the
## deployed tree yet be absent from git: committed source and committed _site
## drift, and on a shared tree a sibling's uncommitted edit would be published
## too. The author commits sources themselves, with their own message; this
## guard makes that the REQUIRED path, not one to remember. Preview uncommitted
## work with --no-commit. Scope: uncommitted render inputs (articles/, pages/,
## site.toml, ...), tracked or untracked -- NOT the build tooling (bin/, tests/,
## .github); the build renders from the working tree, checked BEFORE the build
## so a dirty tree fails in a second, not after a long render.
if [ "${do_commit}" -eq 1 ]; then
   dirty_sources="$(dirty_sources_outside_site)"
   if [ -n "${dirty_sources}" ]; then
      printf '%s\n' "csr-build: refusing to build+publish -- uncommitted source changes outside _site:" >&2
      printf '%s\n' "${dirty_sources}" >&2
      printf '%s\n' "csr-build: commit the source(s) first (their own commit), or re-run with --no-commit to preview without publishing." >&2
      exit 1
   fi
fi
if [ ! -x "${journal_maker}/usr/bin/journal-maker" ]; then
   printf '%s\n' "csr-build: journal-maker not found at ${journal_maker} (set CSR_JOURNAL_MAKER)" >&2
   exit 1
fi
if [ ! -x "${check_site}" ]; then
   printf '%s\n' "csr-build: dist-ai check_site not found at ${check_site} (set CSR_DIST_AI)" >&2
   exit 1
fi
if [ ! -x "${check_svg_safety}" ]; then
   printf '%s\n' "csr-build: dist-ai check_svg_safety not found at ${check_svg_safety} (set CSR_DIST_AI)" >&2
   exit 1
fi

## Build into a staging dir OUTSIDE the content tree: the sandbox refuses to
## --pull a path nested inside a --sync'd tree, and round-tripping the whole
## content tree would risk clobbering a sibling session's in-progress source
## edits. So the generator + content go IN read-only, the site builds into the
## staging tree, and ONLY that tree is pulled back -- host sources are never
## written. Both $SANDBOX_SYNC_* paths are the sandbox-side session locations the
## run exposes for the --sync/--pull trees.
staging="${HOME}/.cache/csr-build-site"

## Start staging empty so a renamed or removed article leaves no stale output:
## the sandbox --pull is an overlay (additive), so a dropped slug would linger
## here and be mirrored into _site by the rsync --delete below -- and deployed.
safe-rm --recursive --force -- "${staging}"

printf '%s\n' "csr-build: building _site in sandbox ${target} ..."

# shellcheck disable=SC2016
sandbox --target "${target}" run --pid-scope private \
   --sync "${journal_maker}" \
   --sync "${content_dir}" \
   --pull "${staging}" \
   --workdir "${content_dir}" \
   -- bash -c 'exec "${SANDBOX_SYNC_JOURNAL_MAKER}"/usr/bin/journal-maker build --articles articles --journal site.toml --out "${SANDBOX_SYNC_CSR_BUILD_SITE}"'

if [ ! -f "${staging}/index.html" ]; then
   printf '%s\n' "csr-build: index.html missing in staging after build (pull failed?)" >&2
   exit 1
fi

## Mirror the freshly built tree into the committed _site. Source is the staging
## dir (NOT a canonical checkout), so this does not copy a checkout out.
rsync --archive --delete -- "${staging}/" "${content_dir}/_site/"
printf '%s\n' "csr-build: built and mirrored into _site."

## Run the dist-ai check_site gate the Pages deploy also runs, here against
## the mirrored _site, so a wording/link/consistency failure is caught HERE --
## before commit+push -- instead of failing the deploy after merge and leaving
## the live site stale. Best-effort EARLY mirror of the deploy gate: it uses
## the LOCAL dist-ai checkout, which tracks master as the deploy's checkout
## does (we branch-track dist-ai, not pin it), so a local checkout left on a
## divergent branch could differ from the deployed revision; the deploy's run
## stays authoritative. Fails closed via errexit; runs in BOTH modes so
## --no-commit is a pre-merge check.
printf '%s\n' "csr-build: running check_site gate ..."
"${check_site}" "${content_dir}/_site"
## The Pages deploy runs a SECOND gate after check_site -- active-content SVG
## safety (stored-XSS on the header-less Pages origin). Run it here too, so a
## blocked SVG fails locally rather than failing the deploy post-merge.
"${check_svg_safety}" "${content_dir}/_site"
printf '%s\n' "csr-build: check_site + check_svg_safety gates clean."

if [ "${do_commit}" -eq 0 ]; then
   printf '%s\n' "csr-build: --no-commit; leaving _site uncommitted."
   exit 0
fi

cd -- "${content_dir}"

## CANARY-RECHECK-START
## Re-check for source changes that raced the multi-minute render (TOCTOU): the
## pre-build guard ran on the pre-render tree, but a concurrent edit landing
## DURING the render is baked into _site while the commit stages only _site --
## publishing source absent from git. Same scope as the pre-build guard.
## (Sentinels delimit the block the source-guard regression canary strips.)
## Accepted residual: catches an edit still present at commit time (the common
## shared-tree case). An edit rendered then reverted, or a source change
## COMMITTED by another session mid-render, leave the tree clean here and slip
## through -- closing those needs rendering from an immutable HEAD snapshot. For
## this public content repo that is self-healing _site staleness, not a leak.
dirty_sources="$(dirty_sources_outside_site)"
if [ -n "${dirty_sources}" ]; then
   printf '%s\n' "csr-build: refusing to commit -- sources changed during the build:" >&2
   printf '%s\n' "${dirty_sources}" >&2
   printf '%s\n' "csr-build: a concurrent edit raced the render; re-run so _site matches committed sources." >&2
   exit 1
fi
## CANARY-RECHECK-END

git add -- _site
if git diff --cached --quiet -- _site; then
   printf '%s\n' "csr-build: _site unchanged; nothing to commit."
   exit 0
fi

## Commit the generated tree by EXPLICIT file paths: the shared-index commit
## guard refuses a directory pathspec (it would sweep a sibling session's staged
## files). _site is wholly this tool's output, so listing its staged files is
## safe and scopes the commit to them alone.
mapfile -t site_files < <(git diff --cached --name-only -- _site)
git commit -F - -- "${site_files[@]}" <<'MSG'
Rebuild site

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
MSG

git-push
printf '%s\n' "csr-build: committed + pushed."
